{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArtificialMemoryArenaDataset",
  "type": "object",
  "required": ["scenarios", "questions"],
  "properties": {
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario_id", "turns"],
        "properties": {
          "scenario_id": {"type": "string"},
          "turns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["turn_index", "speaker", "content"],
              "properties": {
                "turn_index": {"type": "integer"},
                "speaker": {"type": "string", "enum": ["user", "assistant", "system"]},
                "content": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "category", "question", "ground_truth", "difficulty"],
        "properties": {
          "question_id": {"type": "string"},
          "category": {"type": "string"},
          "question": {"type": "string"},
          "ground_truth": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "forbidden": {
            "type": "array",
            "items": {"type": "string"}
          },
          "expected_abstention": {"type": "boolean"},
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard", "adversarial"]
          }
        }
      }
    }
  }
}
